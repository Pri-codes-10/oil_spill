# OWNER: B3 (attribution / live AIS). Copy to .env for local development:
#     cp .env.example .env
#
# .env is gitignored. NEVER commit the real key, and never paste it in chat.
# If a key ever reaches a pushed commit, rotate it at aisstream.io FIRST --
# deleting the commit does not un-leak it.

# aisstream.io websocket key (free, sign in with GitHub).
# Read by scripts/ais_collector.py:34
AISSTREAM_KEY=

# PostGIS connection for the live AIS collector.
# Read by scripts/ais_collector.py:58
# Explicit user/password/port so this works against a stock local postgres or
# the usual docker image; trim it back if your server uses peer auth.
PG_DSN=postgresql://postgres:postgres@localhost:5432/spilltrace
