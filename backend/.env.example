# Copy to .env for local development:  cp .env.example .env
# .env is gitignored. NEVER commit the real key, and never paste it in chat.
# If a key ever reaches a pushed commit, rotate it at aisstream.io FIRST --
# deleting the commit does not un-leak it.

# B3: aisstream.io websocket key (free, sign in with GitHub).
# Read by scripts/ais_collector.py
AISSTREAM_KEY=

# B3: PostGIS connection for the live AIS collector.
# Read by scripts/ais_collector.py
PG_DSN=postgresql://postgres:postgres@localhost:5432/spilltrace
