# .gitignore — data
# OWNER: everyone. Commit this BEFORE the first commit, not after.
# See WORKFLOW.md §4.6 — one accidental large-file commit poisons repo history.

*.tif
*.tiff
*.npy
*.7z
*.nc
*.zip
*.SAFE/
# Excluding the directory itself (cache/) makes the .gitkeep un-addable:
# git cannot re-include a file whose parent dir is excluded. Match CONTENTS
# instead, so the dir can be tracked while its output stays ignored.
cache/*
!cache/.gitkeep
data/
*.pt
*.pth
__pycache__/
.env

# standard python noise
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/
.DS_Store
